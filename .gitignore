# ═══════════════════════════════════════════════════════════════════════════════
# WhAppend — Root .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Environment & Secrets (NEVER COMMIT) ───────────────────────────────────────
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# ── Python & Backend ───────────────────────────────────────────────────────────
backend/.env
backend/.env.*
!backend/.env.example
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.log

# ── Runtime Storage & Media (Videos, frames, ChromaDB) ─────────────────────────
backend/storage/videos/*
!backend/storage/videos/.gitkeep
backend/storage/frames/*
!backend/storage/frames/.gitkeep
backend/storage/chroma/*
!backend/storage/chroma/.gitkeep
storage/
backend/scratch/

# ── Node & Frontend ────────────────────────────────────────────────────────────
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
frontend/build/
frontend/.env.local
frontend/.env*.local
!frontend/.env.example

# ── Package manager logs ───────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS & IDE ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─────────────────────────────────────────────────────────────────────────────
# WhAppend backend — environment configuration
# Copy this file to .env and fill in your values.
# Clients can also supply their own API key directly in the web UI.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: "groq" (recommended, fast & free tier) | "openai"
LLM_PROVIDER=groq

# ── Groq API Key (get free at https://console.groq.com) ───────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_LLM_MODEL=qwen/qwen3.8-27b

# ── OpenAI (optional, only needed if LLM_PROVIDER=openai) ────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Embeddings ────────────────────────────────────────────────────────────────
# Options: "local" (sentence-transformers, 100% free, runs on CPU) | "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Mock mode — set to true to run WITHOUT any API calls ──────────────────────
# Great for UI testing. Returns realistic synthetic events.
MOCK_MODE=false

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
CHROMA_DIR=./storage/chroma

# ── Processing ────────────────────────────────────────────────────────────────
FRAME_INTERVAL_SECONDS=2
FRAME_BATCH_SIZE=4
MAX_VIDEO_SIZE_MB=500

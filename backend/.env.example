# ─────────────────────────────────────────────────────────────────────────────
# WhAppend backend — environment configuration
# Copy this file to .env and fill in your values.
#
# BYOK ONLY: There is NO server-wide GROQ_API_KEY. Every allowlisted user
# configures their own Groq API key via Telegram (/setkey) or the Web UI,
# and it is stored encrypted (Fernet) in the database.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres recommended; leave empty for local SQLite dev) ──
# Example Neon URL:
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Security & Encryption ───────────────────────────────────────────────────
# Generate all secrets with:  python cli.py generate-secrets
APP_ENCRYPTION_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# ── Phone Allowlist Seed ────────────────────────────────────────────────────
# Comma-separated E.164 phone numbers automatically added as admins on startup.
# You can also add/remove numbers via `python cli.py add-user +5511999999999`
# or `/admin_add +5511999999999` inside Telegram.
ADMIN_PHONES=+5511999999999
DEFAULT_PHONE_REGION=BR

# ── Telegram Bot Integration ────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram and paste the token here:
TELEGRAM_BOT_TOKEN=
# Leave TELEGRAM_WEBHOOK_URL empty in local development to use long-polling automatically.
# Set to your public HTTPS backend URL in production (e.g. https://api.yourdomain.com):
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── LLM Models (Groq BYOK) ──────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_LLM_MODEL=qwen/qwen3.8-27b

# ── Embeddings (local sentence-transformers, 100% free on CPU) ──────────────
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Mock mode (set true to test without any external API calls) ─────────────
MOCK_MODE=false

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
CHROMA_DIR=./storage/chroma

# ── Processing ──────────────────────────────────────────────────────────────
FRAME_INTERVAL_SECONDS=2
FRAME_BATCH_SIZE=4
MAX_VIDEO_SIZE_MB=500
